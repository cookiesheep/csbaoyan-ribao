# Local raw chat export directory
# 路线 B（推荐，不封号）：ingest 命令从本地 NTQQ 库导出 JSON 到这里
CSBAOYAN_EXPORT_DIR=chat_exports

# Generated site data
CSBAOYAN_PAGES_DIR=pages
# CSBAOYAN_XHS_EXPORT=false  # 开启后每日出报时额外生成小红书素材 JSON

# ===== 路线 B：本地 NTQQ 数据库直读（不封号的数据源）=====
# 已解密的 NTQQ 明文 SQLite 数据库路径（用 qq_dump_db 解密后得到）
CSBAOYAN_NTQQ_DB_PATH=C:\Users\<username>\output\<QQ号>\nt_msg.db
# 目标群过滤值（群号或群名片段；精确列名用 ingest --inspect 校准后填 --group-column）
CSBAOYAN_GROUP_CODE=
# 你的 QQ 号（仅用于 qq_dump_db 解密步骤的 --qq 参数）
CSBAOYAN_NTQQ_QQ=
# qq_dump_db 解密输出目录（daily_full.ps1 用）
CSBAOYAN_DUMP_DB_DIR=

# OpenAI-compatible provider config
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_api_key_here
# DeepSeek 自 2026-07-24 起使用 v4 模型名；旧的 deepseek-chat 已停用。
OPENAI_MODEL=deepseek-v4-flash
# 可选：仅当主 Key 明确返回余额/配额不足时自动切换，不会因普通超时或限流切换。
OPENAI_FALLBACK_API_KEY=

# Telegram broadcast config
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username
SITE_BASE_URL=https://csbaoyan.icelon.top
