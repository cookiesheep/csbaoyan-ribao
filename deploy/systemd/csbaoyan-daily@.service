[Unit]
Description=Generate csbaoyan report and XHS export for %i
After=network-online.target
Wants=network-online.target
OnSuccess=xhs-pack-sync.service

[Service]
Type=oneshot
User=csbaoyan
Group=csbaoyan
WorkingDirectory=/opt/csbaoyan-daily
EnvironmentFile=/etc/csbaoyan/csbaoyan.env
ExecStart=/opt/csbaoyan-daily/scripts/server_process_daily.sh %i
Nice=5
CPUQuota=400%
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/csbaoyan-daily /var/www/csbaoyan/data /var/www/internal

